# Salin berkas ini menjadi .env lalu isi sesuai kebutuhan.
# Berkas .env tidak pernah di-commit (lihat .gitignore).

# Lingkungan: local | production
APP_ENV=local
APP_DEBUG=true

# Jalur basis data SQLite (relatif terhadap root proyek)
DB_PATH=storage/keuangan.sqlite

# Email OTP via SMTP Brevo — aktifkan (true) setelah kredensial diisi
MAIL_ENABLED=false
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Pencatat Keuangan

# Google OAuth (FR-005) — buat "OAuth 2.0 Client ID" tipe Web application di Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL callback — daftarkan PERSIS sama pada "Authorized redirect URIs" di console:
#   lokal    : http://localhost:8080/google-callback.php
#   produksi : https://domain-anda/google-callback.php
# Catatan: localhost dan 127.0.0.1 dianggap URL berbeda oleh Google — samakan persis.
GOOGLE_REDIRECT_URI=http://localhost:8080/google-callback.php
